# SERVER
PORT=3000
NODE_ENV=production
BASE_URL=https://tu-dominio.com

# DATABASE
DB_PATH=./data/novu.db
# For Railway with mounted volume:
# DB_PATH=/data/novu.db

# AI (use one: openai, anthropic, or gemini)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
DEFAULT_AI_MODEL=gpt-4o-mini

# WEB SEARCH (optional)
SERPER_API_KEY=...

# EMAIL (lead notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@email.com
SMTP_PASS=...
FROM_EMAIL=noreply@tu-dominio.com

# SECURITY
JWT_SECRET=cambiar-por-string-aleatorio-largo
ADMIN_MASTER_KEY=para-crear-negocios-desde-api
